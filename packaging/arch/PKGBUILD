# Maintainer: S3-R4
#
# A local build of ricepilot for Arch Linux (and CachyOS, which it was
# written on). From this directory:
#
#     makepkg              # builds, runs the test suite, writes ricepilot-*.pkg.tar.zst here
#     makepkg --install    # the same, then pacman -U installs it (asks for your password)
#
# Why this file is in packaging/arch/ and not at the repository root
# (docs/DECISIONS.md D65): makepkg puts its build tree at "$BUILDDIR/src" and
# "$BUILDDIR/pkg", and BUILDDIR defaults to the directory the PKGBUILD is in.
# At the root, "$srcdir" would be the crate's own src/ — the checkout would be
# unpacked into the Rust sources, and `makepkg --clean` / `--cleanbuild` run
# `rm -rf "$srcdir"`, which would delete them. Here, src/ and pkg/ are
# packaging/arch/src and packaging/arch/pkg, which .gitignore covers.
#
# Where the source comes from: a git clone of this repository, by path.
# `git+file://` clones what is *committed* on the branch checked out there —
# uncommitted edits are not in the package, so what is built is always a
# commit you can name. For a published release, replace the line with the
# tag's tarball, e.g.
#     source=("$pkgname-$pkgver.tar.gz::https://github.com/S3-R4/ricepilot/archive/refs/tags/v$pkgver.tar.gz")
# and put its sha256 in sha256sums (and `cd "$pkgname-$pkgver"` below).
#
# The network is used in prepare() only: `cargo fetch` against the committed
# Cargo.lock. build() and check() run with --frozen and CARGO_NET_OFFLINE, so
# a dependency that is not in Cargo.lock, or not already fetched, is a build
# failure, never a download.

pkgname=ricepilot
pkgver=0.1.0
pkgrel=1
pkgdesc='Atomically switch a Linux desktop between complete rice profiles by re-pointing directory symlinks'
arch=('x86_64')
url='https://github.com/S3-R4/ricepilot'
# Cargo.toml: license = "MIT OR Apache-2.0" (an SPDX expression, which is
# what Arch's license array takes). The repository has no LICENSE file yet;
# package() installs one if it appears.
license=('MIT OR Apache-2.0')
# The binary links libc and libgcc_s (unwinding: panic = "unwind" in
# Cargo.toml), and nothing else — `readelf -d` lists exactly those two.
# libgcc_s is in `libgcc` since Arch split gcc-libs; on a system from before
# the split, `gcc-libs` is the package that has it.
depends=('glibc' 'libgcc')
makedepends=('cargo' 'git')
# Each is found by absolute path in /usr/bin or /usr/local/bin, never through
# PATH, and each is optional: ricepilot says what it did not check when one
# is missing.
optdepends=('pacman: the requires-check (a profile with `requires` is refused without it)'
            'hyprland: the sandboxed Hyprland --verify-config pre-flight'
            'uwsm: switch --relogin / rollback --relogin (uwsm stop)')
source=("$pkgname::git+file://${startdir%/packaging/arch}")
sha256sums=('SKIP')

# RUSTUP_TOOLCHAIN=stable, as Arch's Rust package guidelines have it, makes a
# rustup install build with the stable toolchain. With the distro `rust`
# package there is no rustup and nothing reads it, so it is harmless either
# way.

prepare() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  export CARGO_NET_OFFLINE=true
  cargo build --frozen --release
}

check() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  # The suite builds its crash helpers with a nested `cargo build --locked
  # --example …`; CARGO_NET_OFFLINE keeps that one off the network too.
  export CARGO_NET_OFFLINE=true
  # Every test runs inside ricepilot's test sandbox (docs/DECISIONS.md D56):
  # fixtures under target/fixtures of this checkout, never $HOME, and never
  # Hyprland, hyprctl or uwsm. RICEPILOT_LIVE_TESTS=1 is the one way a test
  # reaches the real Hyprland; a package build never does.
  unset RICEPILOT_LIVE_TESTS
  cargo test --frozen
}

package() {
  cd "$pkgname"
  install -Dm755 target/release/ricepilot "$pkgdir/usr/bin/ricepilot"

  # README.md links to docs/*.md relatively, so they go in beside it:
  # /usr/share/doc/ricepilot/docs/RECOVERY.md is the one to find from a TTY.
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 -t "$pkgdir/usr/share/doc/$pkgname/docs" docs/*.md

  local f
  for f in LICENSE LICENSE-MIT LICENSE-APACHE COPYING; do
    if [[ -f $f ]]; then
      install -Dm644 "$f" "$pkgdir/usr/share/licenses/$pkgname/$f"
    fi
  done
}
